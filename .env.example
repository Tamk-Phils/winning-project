# =================================================================
# AGRIFLOW ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env or configure in your deployment provider (Vercel / Supabase)
# Never commit real secrets or service-role keys to source control!
# =================================================================

# --- 1. SUPABASE DATABASE & REALTIME (Free Tier Available) ---
# Project URL and public anonymous key from Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here

# Note: AgriFlow automatically operates in offline/local storage mode
# if Supabase keys are not set, maintaining full UI functionality.

# --- 2. MODULAR EMAIL NOTIFICATION SERVICE (Free Tier) ---
# Supported providers: Resend (free 3,000 emails/month) or SMTP
# If unset, AgriFlow safely operates in Development Preview Simulator Mode
# where emails are logged locally and viewable in the Admin Dashboard.
VITE_RESEND_API_KEY=
VITE_EMAIL_FROM="AgriFlow Exchange <notifications@agriflow.dev>"
VITE_SMTP_HOST=
VITE_SMTP_PORT=587
VITE_SMTP_USER=
VITE_SMTP_PASS=

# --- 3. SMS SERVICE INTERFACE (Future-Ready Feature Flag) ---
# Live SMS is disabled by default for the free prototype.
# AgriFlow uses an in-app SMS simulator clearly labeled as a test.
VITE_ENABLE_LIVE_SMS=false
VITE_TWILIO_ACCOUNT_SID=
VITE_TWILIO_AUTH_TOKEN=
VITE_TWILIO_PHONE_NUMBER=
VITE_AFRICASTALKING_API_KEY=
VITE_AFRICASTALKING_USERNAME=

# --- 4. ADMINISTRATIVE ACCESS & SECURITY ---
# Passcode used to unlock the protected Admin Observability Center
VITE_ADMIN_PASSCODE=agriflow-admin-2026

# --- 5. DEMAND RADAR CRAWLER & PUBLIC FEEDS ---
# Public agricultural tender bulletin endpoints (read-only open APIs/RSS)
VITE_DEMAND_RADAR_SCAN_INTERVAL_MINUTES=60
